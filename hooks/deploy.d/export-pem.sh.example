#!/bin/sh
set -eu

# Certbot передаёт путь к обновлённому lineage через RENEWED_LINEAGE.
lineage=${RENEWED_LINEAGE:?Certbot не передал RENEWED_LINEAGE}

# Имя lineage используется как имя итогового PEM-файла.
name=${lineage##*/}

# Допускаем только безопасные символы в имени файла.
case "$name" in
  ""|*[!A-Za-z0-9._-]*)
    echo "Недопустимое имя сертификата: $name" >&2
    exit 1
    ;;
esac

output="/export/haproxy/${name}.pem"

# Временный файл создаётся в том же каталоге, чтобы последующий mv
# атомарно заменил PEM, не оставив частично записанный файл.
temporary="${output}.$$"
trap 'rm -f "$temporary"' EXIT HUP INT TERM

# Новому файлу назначаются права владельца на запись и группы на чтение.
umask 027

# Собираем цепочку сертификатов и приватный ключ в один PEM-файл.
cat "$lineage/fullchain.pem" "$lineage/privkey.pem" > "$temporary"
chmod 0640 "$temporary"

# Каталог export/haproxy имеет setgid, поэтому файл наследует
# группу CERT_EXPORT_GID без вызова chgrp.
mv -f "$temporary" "$output"

# Временный файл перемещён; очистка больше не нужна.
trap - EXIT HUP INT TERM
